{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "https://app.klymb.ai/dashboard",
      "permanent": true
    },
    {
      "source": "/claude-signup",
      "destination": "https://app.klymb.ai/claude-signup",
      "permanent": true
    },
    {
      "source": "/verify/:path*",
      "destination": "https://app.klymb.ai/verify/:path*",
      "permanent": true
    },
    {
      "source": "/claim/:path*",
      "destination": "https://app.klymb.ai/claim/:path*",
      "permanent": true
    },
    {
      "source": "/r/:path*",
      "destination": "https://app.klymb.ai/r/:path*",
      "permanent": true
    },
    {
      "source": "/hackathon",
      "destination": "https://app.klymb.ai/hackathon",
      "permanent": true
    },
    {
      "source": "/hackathon/:path*",
      "destination": "https://app.klymb.ai/hackathon/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/the-show",
      "destination": "/index.html"
    },
    {
      "source": "/conversations",
      "destination": "/index.html"
    },
    {
      "source": "/guests",
      "destination": "/index.html"
    },
    {
      "source": "/meet-anil",
      "destination": "/index.html"
    },
    {
      "source": "/campus",
      "destination": "/index.html"
    },
    {
      "source": "/editorial",
      "destination": "/index.html"
    },
    {
      "source": "/editorial/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/episodes.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/episodes",
      "schedule": "30 18 * * *"
    }
  ]
}
