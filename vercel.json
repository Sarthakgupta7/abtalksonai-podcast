{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/the-show",
      "destination": "/index.html"
    },
    {
      "source": "/conversations",
      "destination": "/index.html"
    },
    {
      "source": "/guests",
      "destination": "/index.html"
    },
    {
      "source": "/meet-anil",
      "destination": "/index.html"
    },
    {
      "source": "/campus",
      "destination": "/index.html"
    },
    {
      "source": "/editorial",
      "destination": "/index.html"
    },
    {
      "source": "/editorial/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/episodes.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/episodes",
      "schedule": "30 18 * * *"
    }
  ]
}
